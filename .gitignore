# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# knowledge corpus
# The committed files under content/knowledge/ are the SYNTHESIS layer only:
# frontmatter, the one-line principle, and the Key lessons digest. The verbatim
# episode transcripts are the original creators' copyrighted work and are not
# redistributed here. If you pull them down locally (e.g. to build embeddings
# for semantic retrieval), keep them in these ignored paths.
content/knowledge/**/_raw/
content/knowledge/**/_pipeline/
content/knowledge/_transcripts/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
