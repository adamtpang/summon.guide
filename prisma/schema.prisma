generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  name                   String?
  email                  String?                @unique
  emailVerified          DateTime?
  image                  String?
  credits                Int                    @default(10)
  membershipStatus       MembershipStatus       @default(FREE)
  membershipSessionsUsed Int                    @default(0)
  membershipSessionLimit Int                    @default(5)
  membershipRenewsAt     DateTime?
  stripeCustomerId       String?                @unique
  stripeSubscriptionId   String?                @unique
  accounts               Account[]
  sessions               Session[]
  feedbacks              Feedback[]
  guideRequests          GuideRequest[]
  mcpAuthorizationCodes  McpAuthorizationCode[]
  mcpAccessTokens        McpAccessToken[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

enum MembershipStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum GuideRequestKind {
  PERSON
  CHANNEL
  BOOK
}

enum GuideRequestStatus {
  REQUESTED
  TRIAGED
  SOURCING
  CORPUS_BUILDING
  DISTILLING
  VERIFYING
  READY
  DECLINED
}

model GuideRequest {
  id             String             @id @default(cuid())
  userId         String
  requestedName  String
  normalizedName String
  kind           GuideRequestKind
  problem        String?
  sourceUrl      String?
  status         GuideRequestStatus @default(REQUESTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([normalizedName])
  @@index([status, createdAt])
}

model McpOAuthClient {
  id                 String                 @id @default(cuid())
  clientId           String                 @unique
  clientName         String?
  redirectUris       String
  createdAt          DateTime               @default(now())
  authorizationCodes McpAuthorizationCode[]
  accessTokens       McpAccessToken[]
}

model McpAuthorizationCode {
  id            String         @id @default(cuid())
  codeHash      String         @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())
  client        McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model McpAccessToken {
  id               String         @id @default(cuid())
  tokenHash        String         @unique
  refreshTokenHash String?        @unique
  clientId         String
  userId           String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime?
  client           McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String
  figureSlug String
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([figureSlug])
  @@index([userId])
}

// Holds the Claude subscription (Pro/Max) OAuth credential the guide chat route bills
// against, instead of a metered ANTHROPIC_API_KEY. A single row, id fixed to "default".
//
// Why this exists: an env-var access token (the previous approach, ANTHROPIC_AUTH_TOKEN)
// expires in hours and a Vercel function has nowhere to write its own env vars, so the
// token silently goes stale until someone re-mints it by hand. Persisting BOTH the access
// token and the refresh token here lets the server refresh itself: read this row, and if
// accessTokenExpiresAt is close, exchange refreshToken for a new pair via Anthropic's OAuth
// endpoint and write the result back. See src/lib/anthropicOAuth.ts.
//
// refreshToken ROTATES on every use (Anthropic invalidates the old one), so the row is
// updated with a compare-and-swap on the refresh token value: whichever concurrent request
// wins the race persists its refresh, the other reads the now-current row instead of
// retrying with a refresh token that's already been spent.
model AnthropicOAuthToken {
  id                    String    @id @default("default")
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  scopes                String?
  updatedAt             DateTime  @updatedAt
}
